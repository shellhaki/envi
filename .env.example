# Copy to .env and fill in before `docker compose up -d`.
# DATABASE_URL and REDIS_URL are not here on purpose — compose sets those to
# the internal service names, so anything you put here would be ignored.

# Exactly 32 characters. Generate with: openssl rand -hex 16
# This decrypts every secret you store. Losing it means losing all of them,
# and there is deliberately no recovery path around it.
ENVI_ENCRYPTION_KEY=

# At least 32 characters. Generate with: openssl rand -hex 16
# Signs the dashboard's session cookies.
ENVI_SESSION_SECRET=

# Outbound email for one-time codes and invitations.
# Key: https://resend.com/api-keys — the From address must be on a domain
# you have verified with Resend, or delivery is limited to your own address.
RESEND_API_KEY=
RESEND_FROM="Envi <noreply@yourdomain.com>"

# Public URL of the dashboard. Invitation links in emails are built from it,
# so it must be reachable by the people you invite.
ENVI_WEB_URL=http://localhost:3000

# Postgres password for the bundled database.
POSTGRES_PASSWORD=change-me

# Set to `beta` to restrict sign-in to the addresses in the allowlist below —
# a JSON array of emails. Edit the file, then `docker compose restart api`.
ENVIRONMENT=production
ENVI_BETA_ALLOWLIST=./beta_testers.example.json

# Host ports. Change if something already occupies them.
ENVI_WEB_PORT=3000
ENVI_API_PORT=8080
ENVI_SERVER_PORT=8081


ADMINS=email1@...,email2@... 