# The backend as one Coolify application: the API on 8080 and the
# install-script server on 8081, supervised by scripts/docker-entrypoint.sh.
#
# docker-compose.yml deliberately does not use this file — it runs the two as
# separate services from Dockerfile and Dockerfile.install.
#
# Coolify settings:
#   Build Pack        Dockerfile
#   Dockerfile        Dockerfile.coolify
#   Base Directory    /
#   Ports Exposes     8080,8081
# Map api.<domain> to 8080 and install.<domain> to 8081.

FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/envi-api ./cmd/api \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/envi-install ./cmd/install

FROM alpine:3.22
# Outbound TLS (Resend, Neon) needs root certificates.
RUN apk add --no-cache ca-certificates
WORKDIR /app

COPY --from=build /out/envi-api /out/envi-install /usr/local/bin/
COPY scripts/docker-entrypoint.sh /usr/local/bin/envi-entrypoint
RUN chmod +x /usr/local/bin/envi-entrypoint

# Payload the install server reads at startup, relative to its working
# directory — not build-time assets.
COPY scripts/install.sh scripts/install.ps1 ./scripts/

# Beta mode additionally reads ./beta_testers.json and refuses to start without
# it. That file is gitignored, so with ENVIRONMENT=beta you must add it to the
# image or mount it as a Coolify file mount at /app/beta_testers.json.

ENV ENVI_API_PORT=8080 ENVI_SERVER_PORT=8081
EXPOSE 8080 8081

# Both halves have to answer, or the container is not healthy.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD \
  wget -qO- "http://127.0.0.1:${ENVI_API_PORT}/health" >/dev/null 2>&1 \
  && wget -qO- "http://127.0.0.1:${ENVI_SERVER_PORT}/health" >/dev/null 2>&1 || exit 1

ENTRYPOINT ["/usr/local/bin/envi-entrypoint"]
