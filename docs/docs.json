{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Envi",
  "description": "Environment secrets, encrypted, scoped, and audited.",
  "colors": {
    "primary": "#0c111d",
    "light": "#f5f7fa",
    "dark": "#1a1e26"
