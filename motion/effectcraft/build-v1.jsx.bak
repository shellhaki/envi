/*
  The Envi promo, built in EffectCraft from the After Effects object model.

  The look it reproduces: each new element arrives as a blurred, glowing red
  shape and resolves into something crisp, while the line re-centres around it.
  That one move — bloom resolving into focus — is the whole idiom, used for the
  words in scene one and for the product cards in scene two.

  Run with:  effectcraft-cli script build.jsx
*/

var FPS = 60;
var W = 1920;
var H = 1080;
var DUR = 21;

// Envi's tokens, as ui/app/globals.css defines them, in 0..1 channels.
var WHITE = [0.98, 0.98, 0.98];
var INK = [0.035, 0.035, 0.043];
var MUTED = [0.44, 0.44, 0.48];
var RED = [0.91, 0.19, 0.25];

var HERE = "/Users/shellhaki/Documents/envi/motion/effectcraft/";
var DEMO = "/Users/shellhaki/Documents/envi/ui/public/demo.mp4";
var LOGO = "/Users/shellhaki/Documents/envi/ui/public/envi-logo-with-text-light-mode.png";

// ---------------------------------------------------------------- helpers

/** ease applies a soft start and a long settle to every key of a property. */
function ease(prop, inPct, outPct) {
  var i = new KeyframeEase(0, inPct === undefined ? 75 : inPct);
  var o = new KeyframeEase(0, outPct === undefined ? 85 : outPct);
  for (var k = 1; k <= prop.numKeys; k++) {
    var dims = prop.value instanceof Array ? prop.value.length : 1;
    var ins = [], outs = [];
    for (var d = 0; d < dims; d++) { ins.push(i); outs.push(o); }
    prop.setTemporalEaseAtKey(k, ins, outs);
  }
}

function key(prop, pairs) {
  for (var i = 0; i < pairs.length; i++) prop.setValueAtTime(pairs[i][0], pairs[i][1]);
  return prop;
}

function T(layer) { return layer.property("Transform"); }

/** text makes a text layer with its document already applied. */
function text(comp, body, size, style, color) {
  var layer = comp.layers.addText(body);
  var doc = layer.property("Source Text").value;
  doc.font = style;
  doc.fontSize = size;
  doc.fillColor = color;
  doc.applyFill = true;
  doc.tracking = -28; // the tight tracking the product's own type uses
  layer.property("Source Text").setValue(doc);
  return layer;
}

function imported(path) {
  return app.project.importFile(new ImportOptions(new File(path)));
}

/*
  place adds an imported item and centres its anchor.

  An imported layer's anchor starts at its top-left corner, so scaling it moves
  the picture across the frame instead of growing it where it stands. Every
  scale here is animated, so without this every card drifts.
*/
function place(comp, item, name, x, y, scale) {
  var layer = comp.layers.add(item);
  layer.name = name;
  T(layer).property("Anchor Point").setValue([item.width / 2, item.height / 2]);
  T(layer).property("Position").setValue([x, y]);
  T(layer).property("Scale").setValue([scale, scale]);
  return layer;
}

/*
  bloom is the signature entrance: blurred, glowing and red on arrival, crisp
  and settled a third of a second later.

  tint false leaves the layer's own colours alone, which is what the product
  screenshots want — a red-tinted dashboard would be a lie about the product.
  They still arrive blurred and glowing, so the move reads the same.
*/
function bloom(layer, at, settle, tint) {
  var blur = layer.property("Effects").addProperty("Gaussian Blur");
  key(blur.property("Blurriness"), [[at, 95], [at + settle * 0.62, 0]]);
  ease(blur.property("Blurriness"), 92, 60);

  var glow = layer.property("Effects").addProperty("Glow");
  key(glow.property("Glow Threshold"), [[at, 12]]);
  key(glow.property("Glow Radius"), [[at, 260], [at + settle, 0]]);
  key(glow.property("Glow Intensity"), [[at, 3.6], [at + settle * 0.85, 0]]);
  ease(glow.property("Glow Intensity"), 92, 70);

  if (tint !== false) {
    // Fill rather than the text document's own colour: a document is a value,
    // not a property, so its colour cannot be keyframed. The effect can.
    var fill = layer.property("Effects").addProperty("Fill");
    key(fill.property("Color"), [[at, RED], [at + settle * 0.75, INK]]);
    ease(fill.property("Color"), 80, 70);
  }

  key(T(layer).property("Opacity"), [[at - 0.07, 0], [at, 100]]);
  key(T(layer).property("Scale"), [[at, [113, 113]], [at + settle, [100, 100]]]);
  ease(T(layer).property("Scale"), 88, 80);
}

/** fadeOut takes a layer off screen, and keeps it off. */
function fadeOut(layer, at, over) {
  var o = T(layer).property("Opacity");
  o.setValueAtTime(at, o.numKeys ? 100 : 100);
  o.setValueAtTime(at + over, 0);
  ease(o, 70, 80);
}

// ------------------------------------------------------- the kinetic line

/*
  buildLine lays a sentence out word by word. Each word is its own layer,
  because the incoming one has to be coloured and blurred on its own while the
  settled ones stay crisp — and because the line re-centres as it grows, which
  means every word already on screen moves when a new one lands.
*/
function buildLine(comp, words, baseline, size, startAt, gap) {
  var layers = [], widths = [], space = size * 0.26;

  for (var i = 0; i < words.length; i++) {
    var layer = text(comp, words[i].body, size, words[i].style, INK);
    var rect = layer.sourceRectAtTime(0, false);
    layers.push({ layer: layer, rect: rect });
    widths.push(rect.width);
  }

  // The left edge of word i once words 0..stage are all on screen.
  function leftOf(i, stage) {
    var total = 0, w;
    for (w = 0; w <= stage; w++) total += widths[w] + (w > 0 ? space : 0);
    var x = W / 2 - total / 2;
    for (w = 0; w < i; w++) x += widths[w] + space;
    return x;
  }

  for (var j = 0; j < layers.length; j++) {
    var at = startAt + j * gap;
    var item = layers[j];
    var pos = T(item.layer).property("Position");
    // sourceRectAtTime is measured from the layer's anchor, so subtracting
    // rect.left turns "where the glyphs should start" into "where the layer
    // goes". Without it every word sits one side bearing off.
    var place = (function (idx, rect) {
      return function (stage) { return [leftOf(idx, stage) - rect.left, baseline]; };
    })(j, item.rect);

    pos.setValueAtTime(at, [place(j)[0] + 46, baseline + 26]);
    pos.setValueAtTime(at + 0.42, place(j));
    for (var stage = j + 1; stage < layers.length; stage++) {
      var when = startAt + stage * gap;
      pos.setValueAtTime(when - 0.01, place(stage - 1));
      pos.setValueAtTime(when + 0.38, place(stage));
    }
    ease(pos, 85, 88);
    bloom(item.layer, at, 0.42, true);
  }

  return layers;
}

// ---------------------------------------------------------------- the build

var comp = app.project.items.addComp("Promo", W, H, 1, DUR, FPS);
comp.bgColor = WHITE;

// Everything sits on a white card rather than the comp background, because
// bgColor is a project setting and cannot be keyframed.
var paper = comp.layers.addSolid(WHITE, "paper", W, H, 1);

// --- scene 1: the problem, one word at a time -----------------------------

var line1 = buildLine(comp, [
  { body: "Your", style: "Inter-SemiBold" },
  { body: "secrets", style: "Inter-Regular" },
  { body: "are", style: "Inter-Regular" },
  { body: "everywhere.", style: "Inter-SemiBold" }
], H / 2, 104, 0.55, 0.52);

for (var i = 0; i < line1.length; i++) fadeOut(line1[i].layer, 4.3, 0.45);

// --- scene 2: three product cards, each blooming in ----------------------

var CARD_AT = [4.9, 5.42, 5.94];
var CARD_X = [W / 2 - 520, W / 2, W / 2 + 520];
var CARD_TILT = [-4, 0, 4];

for (var c = 0; c < 3; c++) {
  var card = place(comp, imported(HERE + "cards/card" + (c + 1) + ".png"),
                   "card" + (c + 1), CARD_X[c], H / 2, 47);
  T(card).property("Rotation").setValue(CARD_TILT[c]);

  var shadow = card.property("Effects").addProperty("Drop Shadow");
  shadow.property("Opacity").setValue(90);
  shadow.property("Distance").setValue(18);
  shadow.property("Softness").setValue(60);

  bloom(card, CARD_AT[c], 0.5, false);
  // bloom writes Scale at 113/100, which would undo the 47% these need.
  var s = T(card).property("Scale");
  while (s.numKeys) s.removeKey(1);
  key(s, [[CARD_AT[c], [54, 54]], [CARD_AT[c] + 0.5, [47, 47]]]);
  ease(s, 88, 80);

  fadeOut(card, 8.5, 0.5);
}

var caption2 = text(comp, "In Slack. On a laptop. In a repo.", 46, "Inter-Regular", MUTED);
var cr = caption2.sourceRectAtTime(0, false);
T(caption2).property("Position").setValue([W / 2 - cr.left - cr.width / 2, H / 2 + 300]);
key(T(caption2).property("Opacity"), [[6.5, 0], [6.9, 100], [8.5, 100], [8.9, 0]]);
ease(T(caption2).property("Opacity"), 70, 80);

// --- scene 3: one card, the real thing, running -------------------------

var demo = place(comp, imported(DEMO), "demo", W / 2, H / 2 - 60, 48);
// The window of the recording worth showing: envi init through envi pull.
demo.startTime = 9.0 - 19.0;
demo.inPoint = 9.0;
demo.outPoint = 15.9;

var demoShadow = demo.property("Effects").addProperty("Drop Shadow");
demoShadow.property("Opacity").setValue(85);
demoShadow.property("Distance").setValue(22);
demoShadow.property("Softness").setValue(70);

bloom(demo, 9.0, 0.55, false);
var ds = T(demo).property("Scale");
while (ds.numKeys) ds.removeKey(1);
// A slow push across the shot, so nothing on screen is ever completely still.
key(ds, [[9.0, [54, 54]], [9.55, [48, 48]], [15.9, [52, 52]]]);
ease(ds, 88, 80);
fadeOut(demo, 15.4, 0.5);

var caption3 = text(comp, "One command, and they are in your shell.", 46, "Inter-Regular", MUTED);
var c3r = caption3.sourceRectAtTime(0, false);
T(caption3).property("Position").setValue([W / 2 - c3r.left - c3r.width / 2, H / 2 + 420]);
key(T(caption3).property("Opacity"), [[10.0, 0], [10.4, 100], [15.0, 100], [15.4, 0]]);
ease(T(caption3).property("Opacity"), 70, 80);

// --- scene 4: the close -------------------------------------------------

var line2 = buildLine(comp, [
  { body: "Keep", style: "Inter-SemiBold" },
  { body: "them", style: "Inter-Regular" },
  { body: "in", style: "Inter-Regular" },
  { body: "one", style: "Inter-Regular" },
  { body: "place.", style: "Inter-SemiBold" }
], H / 2 - 60, 96, 16.1, 0.34);

for (var k2 = 0; k2 < line2.length; k2++) fadeOut(line2[k2].layer, 19.1, 0.5);

var logo = place(comp, imported(LOGO), "logo", W / 2, H / 2 + 150, 22);
bloom(logo, 18.1, 0.5, false);
var ls = T(logo).property("Scale");
while (ls.numKeys) ls.removeKey(1);
key(ls, [[18.1, [26, 26]], [18.6, [22, 22]]]);
ease(ls, 88, 80);

var install = text(comp, "curl -fsSL install.envisecrets.com | sh", 38, "JetBrainsMono-Regular", MUTED);
var ir = install.sourceRectAtTime(0, false);
T(install).property("Position").setValue([W / 2 - ir.left - ir.width / 2, H / 2 + 280]);
key(T(install).property("Opacity"), [[18.7, 0], [19.1, 100]]);
ease(T(install).property("Opacity"), 70, 80);

writeLn("built " + comp.name + " " + comp.width + "x" + comp.height + " @" + comp.frameRate + " " + comp.duration + "s, " + comp.numLayers + " layers");
app.project.save(new File(HERE + "promo.ecproj"));
writeLn("saved promo.ecproj");
